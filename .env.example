# Copy to .env.local and fill in real values. Never commit the real file.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cartpilot-ai

# Auth — generate with: openssl rand -hex 32 (each secret must be a distinct, random 32+ char string)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Email (SMTP) — leave unset in development to log verification links to the server console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CartPilot AI <no-reply@example.com>"

# Shopify Partner app — https://partners.shopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_API_VERSION=2026-07
# read_customers (customer identity on orders) and write_discounts (discount code creation) were
# added later — a store connected before this change must reconnect to re-authorize. Shopify's
# read_orders scope covers only the last 60 days. To sync older orders, request Shopify approval
# for read_all_orders first, then add it here and reconnect the store.
SHOPIFY_SCOPES=read_products,read_orders,read_customers,write_discounts,read_inventory,read_locations

# Daily reconciliation sync — see "Automatic daily sync" in README for scheduling options.
# Leave unset to disable the /api/cron/sync-all endpoint entirely.
CRON_SECRET=

# NVIDIA API Catalog — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
